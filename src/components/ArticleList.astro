---
import sports from '../data/sports.json';
const { articles, heading, note } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const by = (slug) => sports.find((s) => s.slug === slug) ?? {};
---
{articles.length > 0 && (
  <section class="block">
    <div class="wrap">
      <div class="block-head">
        <h2>{heading}</h2>
        {note && <p>{note}</p>}
      </div>
      <div class="cards">
        {articles.map((a) => {
          const s = by(a.data.sport);
          const iso = a.data.date.toISOString().slice(0, 10);
          return (
            <a class="card" href={`${base}/news/${a.id}/`}>
              <div class="meta">
                <span class="accent" style={`--accent:${s.accent};--accent-dark:${s.accentDark}`}>{s.name}</span>
                <span><time datetime={iso}>{a.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}</time></span>
              </div>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>
)}
