---
import sports from '../data/sports.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t1 = sports.filter((s) => s.tier === 1);
const t2 = sports.filter((s) => s.tier === 2);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h4>Core sports</h4>
        {t1.slice(0, 6).map((s) => <a href={`${base}/${s.slug}/`}>{s.name}</a>)}
      </div>
      <div>
        <h4>More sports</h4>
        {t1.slice(6).map((s) => <a href={`${base}/${s.slug}/`}>{s.name}</a>)}
      </div>
      <div>
        <h4>Also covered</h4>
        {t2.map((s) => <a href={`${base}/${s.slug}/`}>{s.name}</a>)}
      </div>
      <div>
        <h4>Site</h4>
        <a href={`${base}/standings/`}>Standings</a>
        <a href={`${base}/archives/`}>Archives</a>
        <a href={`${base}/statistics/`}>Statistics</a>
        <a href={`${base}/about/`}>About us</a>
        <a href={`${base}/contact/`}>Contact</a>
        <a href={`${base}/editorial-policy/`}>Editorial policy</a>
      </div>
      <div>
        <h4>Legal</h4>
        <a href={`${base}/privacy/`}>Privacy policy</a>
        <a href={`${base}/cookies/`}>Cookie policy</a>
        <a href={`${base}/terms/`}>Terms of use</a>
        <a href={`${base}/disclaimer/`}>Disclaimer</a>
        <button type="button" class="linklike" data-cookie-settings>Cookie settings</button>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Global Sports Archive</span>
      <span>Визуализация на GitHub Pages</span>
    </div>
  </div>
</footer>
