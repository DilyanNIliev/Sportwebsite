---
import sports from '../data/sports.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const top = sports.filter((s) => s.tier === 1).slice(0, 6);
---
<header class="site-header">
  <div class="wrap header-row">
    <a class="logo" href={`${base}/`}>
      <span class="logo-mark">GS</span>
      <span>Global Sports</span>
    </a>
    <nav class="nav">
      <div class="nav-scroll">
        {top.map((s) => <a href={`${base}/${s.slug}/`}>{s.name}</a>)}
        <a href={`${base}/archives/`}>Archives</a>
      </div>
      <button id="theme-toggle" class="theme-btn" type="button" aria-label="Toggle theme">◐</button>
    </nav>
  </div>
</header>
