---
/**
 * Съставът на един отбор върху игралната му повърхност: точки с имена,
 * резервите отдолу.
 *
 * Позициите не се пишат на ръка. Идват от схемата — всяко число е една линия,
 * а играчите се четат по ред: първо вратарят, ако спортът има такъв, после
 * линия по линия отзад напред, всяка отляво надясно както я гледа читателят.
 * Затова „4-2-3-1“ работи за футбол, а „1-3-3“ — за ръгби или хокей.
 */
import SurfaceMarkings from './SurfaceMarkings.astro';
import { surfaceFor } from '../data/surfaces.js';

const { data, showHead = true } = Astro.props;
const surfaceKey = data.surface ?? 'pitch';
const surface = surfaceFor(surfaceKey);

/** Разпределя състава по схемата и връща процентни координати за всеки. */
function place(team) {
  const { formation, xi, keeper = true } = team;
  const lines = formation.split('-').map(Number);
  if (lines.some((n) => !Number.isInteger(n) || n < 1)) {
    throw new Error(`Схемата „${formation}“ не е редица от цели числа.`);
  }
  const outfield = lines.reduce((a, b) => a + b, 0);
  const expected = outfield + (keeper ? 1 : 0);
  if (xi.length !== expected) {
    throw new Error(
      `${team.team}: схемата „${formation}“${keeper ? ' плюс вратар' : ''} описва ` +
      `${expected} играчи, а съставът има ${xi.length}.`
    );
  }

  // Своята врата е долу, атаката горе. Линиите се разпределят между двете.
  const top = 16;
  const bottom = keeper ? 74 : 84;
  const step = lines.length > 1 ? (bottom - top) / (lines.length - 1) : 0;

  const out = [];
  let i = 0;
  if (keeper) {
    out.push({ ...xi[0], x: 50, y: 91, keeper: true });
    i = 1;
  }
  lines.forEach((count, li) => {
    const y = bottom - li * step;
    // Колкото по-малко са в една линия, толкова по-навътре стоят.
    const inset = count <= 2 ? 32 : count === 3 ? 19 : count === 4 ? 13 : 8;
    for (let n = 0; n < count; n++) {
      const x = count === 1 ? 50 : inset + n * ((100 - 2 * inset) / (count - 1));
      out.push({ ...xi[i], x, y, dense: count >= 5 });
      i += 1;
    }
  });
  return out;
}

/** Идентификатор за радио бутона на всеки отбор. */
const slug = (name) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const teams = data.teams.map((t) => ({ ...t, spots: place(t), slug: slug(t.team) }));
// С един отбор табовете са излишни.
const tabbed = teams.length > 1;
const footnotes = data.teams.flatMap((t) =>
  t.xi.filter((p) => p.uncertain).map((p) => `${t.short}: ${p.why}.`)
);
const benchLabel = data.benchLabel ?? 'Bench';
---
<div class:list={['lineups', !showHead && 'lineups-bare']}>
  {showHead && (
    <div class="lineups-head">
      <h2>Line-ups</h2>
      <p>{data.match} · {data.venue} · {data.date}</p>
    </div>
  )}

  <div class:list={['lineup-teams', tabbed && 'tabs']}>
    {tabbed && teams.map((t, i) => (
      <input type="radio" name="lineup-team" id={`team-${t.slug}`} checked={i === 0} />
    ))}

    {tabbed && (
      <div class="tablist" role="radiogroup" aria-label="Choose a team">
        {teams.map((t) => (
          <label for={`team-${t.slug}`} style={`--club:${t.colour};--club-dark:${t.colourDark}`}>
            {t.team}
          </label>
        ))}
      </div>
    )}

    {teams.map((t) => (
      <section class={tabbed ? 'tabpanel' : ''}>
      <div class="pitch-card" style={`--club:${t.colour};--club-dark:${t.colourDark}`}>
        <div class="pitch-card-head">
          <h3>{t.team}</h3>
          <p><span class="formation">{t.formation}</span> · {t.coach}</p>
        </div>

        <div
          class:list={['pitch', `surface-${surfaceKey}`]}
          style={`--turf:${surface.turf};--turf-dark:${surface.turfDark};--aspect:${surface.aspect}`}
        >
          <SurfaceMarkings surface={surfaceKey} />

          <ol class="pitch-players">
            {t.spots.map((p) => (
              <li
                class:list={['spot', p.uncertain && 'spot-unknown', p.dense && 'spot-dense']}
                style={`left:${p.x}%;top:${p.y}%`}
                aria-label={p.name ?? 'Position not confirmed'}
              >
                <span class="spot-dot" aria-hidden="true">{p.uncertain ? '?' : ''}</span>
                {/* Без име показваме само кръга — „not confirmed“ на терена изяжда съседите. */}
                {p.name && <span class="spot-name" title={p.full ?? undefined}>{p.name}</span>}
              </li>
            ))}
          </ol>
        </div>

        <div class="bench">
          <p class="bench-label">{benchLabel}</p>
          {t.bench.length > 0 ? (
            <ul class="bench-list">
              {t.bench.map((p) => <li title={p.full ?? undefined}>{p.name}</li>)}
            </ul>
          ) : (
            <p class="bench-empty">Not confirmed</p>
          )}
          {t.benchNote && <p class="bench-note">{t.benchNote}</p>}
        </div>
      </div>
      </section>
    ))}
  </div>

  <p class="note pitch-note">{data.note}</p>
  {footnotes.length > 0 && (
    <ul class="pitch-footnotes">
      {footnotes.map((f) => <li>{f}</li>)}
    </ul>
  )}
</div>
