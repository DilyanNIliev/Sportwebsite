---
/**
 * Фонов мотив за заглавния блок на всеки спорт — терен, писта, табло.
 *
 * Всичко е рисувано на ръка в SVG: нула килобайта изтеглени картинки, нула
 * лицензи за снимки, и се преоразмерява без да се размива. Линиите взимат
 * основния цвят на спорта чрез currentColor, а `.motif-hi` — втория.
 */
const { motif } = Astro.props;
---
<svg class="motif" viewBox="0 0 200 120" aria-hidden="true" focusable="false" role="presentation">
  {motif === 'field' && (
    <g>
      <rect x="10" y="12" width="180" height="96" rx="2" />
      <line x1="100" y1="12" x2="100" y2="108" />
      <circle cx="100" cy="60" r="17" />
      <rect x="10" y="30" width="30" height="60" />
      <rect x="10" y="45" width="12" height="30" />
      <rect x="160" y="30" width="30" height="60" />
      <rect x="178" y="45" width="12" height="30" />
      <circle class="motif-hi" cx="100" cy="60" r="4.5" />
    </g>
  )}

  {motif === 'circuit' && (
    <g>
      <path d="M24 96 C46 96 44 62 66 58 S88 62 96 44 S112 16 138 20 S178 38 176 62 S150 96 124 92 S72 104 24 96 Z" />
      <line class="motif-hi" x1="88" y1="49" x2="100" y2="39" stroke-width="4" />
      <circle cx="66" cy="58" r="2.5" fill="currentColor" stroke="none" />
      <circle cx="138" cy="20" r="2.5" fill="currentColor" stroke="none" />
    </g>
  )}

  {motif === 'arc' && (
    <g>
      <rect x="14" y="12" width="172" height="96" rx="2" />
      <rect x="14" y="38" width="52" height="44" />
      <circle cx="66" cy="60" r="14" />
      <path d="M14 16 A48 44 0 0 1 14 104" />
      <line x1="18" y1="48" x2="18" y2="72" stroke-width="3" />
      <circle class="motif-hi" cx="26" cy="60" r="7" />
    </g>
  )}

  {motif === 'gridiron' && (
    <g>
      <rect x="10" y="14" width="180" height="92" rx="1" />
      <line x1="38" y1="14" x2="38" y2="106" />
      <line x1="66" y1="14" x2="66" y2="106" />
      <line x1="100" y1="14" x2="100" y2="106" stroke-width="1.6" />
      <line x1="134" y1="14" x2="134" y2="106" />
      <line x1="162" y1="14" x2="162" y2="106" />
      <line x1="10" y1="36" x2="190" y2="36" stroke-dasharray="3 7" />
      <line x1="10" y1="84" x2="190" y2="84" stroke-dasharray="3 7" />
      <rect class="motif-hi" x="10" y="14" width="14" height="92" fill="currentColor" stroke="none" opacity=".45" />
      <rect class="motif-hi" x="176" y="14" width="14" height="92" fill="currentColor" stroke="none" opacity=".45" />
    </g>
  )}

  {motif === 'court' && (
    <g>
      <rect x="22" y="14" width="156" height="92" rx="1" />
      <line x1="100" y1="8" x2="100" y2="112" class="motif-hi" stroke-width="2.4" />
      <line x1="34" y1="14" x2="34" y2="106" />
      <line x1="166" y1="14" x2="166" y2="106" />
      <line x1="60" y1="26" x2="140" y2="26" />
      <line x1="60" y1="94" x2="140" y2="94" />
      <line x1="60" y1="26" x2="60" y2="94" />
      <line x1="140" y1="26" x2="140" y2="94" />
    </g>
  )}

  {motif === 'flag' && (
    <g>
      <ellipse cx="104" cy="74" rx="76" ry="30" />
      <ellipse cx="104" cy="74" rx="44" ry="16" stroke-dasharray="4 5" />
      <path class="motif-hi" d="M58 96 C48 84 52 70 66 66 C80 62 92 70 88 82" fill="currentColor" stroke="none" opacity=".4" />
      <circle cx="118" cy="70" r="3.5" fill="currentColor" stroke="none" />
      <line x1="118" y1="70" x2="118" y2="22" />
      <path class="motif-hi" d="M118 22 L146 30 L118 38 Z" fill="currentColor" stroke="none" />
    </g>
  )}

  {motif === 'ring' && (
    <g>
      <rect x="22" y="18" width="156" height="88" />
      <line x1="22" y1="38" x2="178" y2="38" />
      <line x1="22" y1="58" x2="178" y2="58" />
      <line x1="22" y1="78" x2="178" y2="78" />
      <line x1="22" y1="14" x2="22" y2="110" stroke-width="3" class="motif-hi" />
      <line x1="178" y1="14" x2="178" y2="110" stroke-width="3" />
      <circle cx="100" cy="62" r="16" stroke-dasharray="3 6" />
    </g>
  )}

  {motif === 'rink' && (
    <g>
      <rect x="10" y="14" width="180" height="92" rx="28" />
      <line class="motif-hi" x1="100" y1="14" x2="100" y2="106" stroke-width="2.6" />
      <circle cx="100" cy="60" r="13" />
      <line x1="40" y1="14" x2="40" y2="106" />
      <line x1="160" y1="14" x2="160" y2="106" />
      <path d="M10 48 A14 12 0 0 1 10 72" />
      <path d="M190 48 A14 12 0 0 0 190 72" />
      <circle cx="58" cy="34" r="7" />
      <circle cx="142" cy="86" r="7" />
    </g>
  )}

  {motif === 'oval' && (
    <g>
      <ellipse cx="100" cy="60" rx="88" ry="50" />
      <ellipse cx="100" cy="60" rx="52" ry="30" stroke-dasharray="4 6" />
      <rect x="86" y="36" width="28" height="48" />
      <line class="motif-hi" x1="90" y1="38" x2="110" y2="38" stroke-width="2.6" />
      <line class="motif-hi" x1="90" y1="82" x2="110" y2="82" stroke-width="2.6" />
    </g>
  )}

  {motif === 'lanes' && (
    <g>
      <rect x="12" y="16" width="176" height="88" rx="44" />
      <rect x="24" y="26" width="152" height="68" rx="34" />
      <rect x="36" y="36" width="128" height="48" rx="24" />
      <rect x="48" y="46" width="104" height="28" rx="14" />
      <line class="motif-hi" x1="100" y1="16" x2="100" y2="36" stroke-width="3" />
    </g>
  )}

  {motif === 'peaks' && (
    <g>
      <path d="M6 104 L46 44 L74 78 L108 26 L146 76 L170 58 L194 104 Z" />
      <path class="motif-hi" d="M108 26 L94 46 L104 52 L114 44 L122 52 L108 26 Z" fill="currentColor" stroke="none" opacity=".7" />
      <path class="motif-hi" d="M46 44 L36 58 L44 62 L52 56 L58 62 L46 44 Z" fill="currentColor" stroke="none" opacity=".7" />
      <path d="M18 104 C50 96 46 86 74 84 C100 82 96 72 124 70" stroke-dasharray="5 6" />
    </g>
  )}

  {motif === 'diamond' && (
    <g>
      <path d="M100 104 L38 50 A88 88 0 0 1 162 50 Z" />
      <path d="M100 96 L64 62 L100 28 L136 62 Z" />
      <path d="M100 96 L74 72 M100 96 L126 72" stroke-dasharray="3 5" />
      <circle class="motif-hi" cx="100" cy="96" r="4" fill="currentColor" stroke="none" />
      <circle class="motif-hi" cx="100" cy="28" r="4" fill="currentColor" stroke="none" />
      <circle cx="64" cy="62" r="4" fill="currentColor" stroke="none" />
      <circle cx="136" cy="62" r="4" fill="currentColor" stroke="none" />
    </g>
  )}

  {motif === 'dartboard' && (
    <g>
      <circle cx="100" cy="60" r="50" />
      <circle cx="100" cy="60" r="40" />
      <circle cx="100" cy="60" r="26" />
      <circle cx="100" cy="60" r="16" />
      {/* Двайсетте сектора в умален вид: дванайсет спици през целия кръг. */}
      {[0, 30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330].map((a) => (
        <line
          x1={100 + 16 * Math.cos((a * Math.PI) / 180)}
          y1={60 + 16 * Math.sin((a * Math.PI) / 180)}
          x2={100 + 50 * Math.cos((a * Math.PI) / 180)}
          y2={60 + 50 * Math.sin((a * Math.PI) / 180)}
        />
      ))}
      <circle class="motif-hi" cx="100" cy="60" r="6" fill="currentColor" stroke="none" />
    </g>
  )}

  {motif === 'table' && (
    <g>
      <rect x="16" y="18" width="168" height="84" rx="3" />
      <rect x="24" y="26" width="152" height="68" />
      <line x1="58" y1="26" x2="58" y2="94" />
      <path d="M58 46 A16 14 0 0 0 58 74" />
      {[[24, 26], [100, 26], [176, 26], [24, 94], [100, 94], [176, 94]].map(([cx, cy]) => (
        <circle cx={cx} cy={cy} r="5" fill="currentColor" stroke="none" opacity=".5" />
      ))}
      <circle class="motif-hi" cx="140" cy="60" r="5" fill="currentColor" stroke="none" />
    </g>
  )}

  {motif === 'grid' && (
    <g>
      <rect x="36" y="12" width="128" height="96" />
      {[0, 1, 2, 3].map((r) =>
        [0, 1, 2, 3].map((c) => (
          (r + c) % 2 === 0 ? (
            <rect class="motif-hi" x={36 + c * 32} y={12 + r * 24} width="32" height="24" fill="currentColor" stroke="none" opacity=".5" />
          ) : null
        ))
      )}
    </g>
  )}
</svg>
