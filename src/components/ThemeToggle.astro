---
// Трипозиционен превключвател. „Авто“ следва часа на устройството на посетителя;
// ръчният избор се запомня и изключва автоматиката.
// Живее само в бургер менюто.
---
<div class="theme-switch" role="group" aria-label="Colour theme">
  <span class="theme-switch-label">Theme</span>
  <div class="theme-switch-btns">
    <button type="button" data-mode="auto"  aria-pressed="false">Auto</button>
    <button type="button" data-mode="light" aria-pressed="false">Light</button>
    <button type="button" data-mode="dark"  aria-pressed="false">Dark</button>
  </div>
</div>
