---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import autoThemeSrc from '../scripts/auto-theme.js?raw';

const { title, description, breadcrumb, noindex } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteName = 'Global Sports Archive';
const full = title ? `${title} — ${siteName}` : siteName;

// Един източник на истината: същият файл се ползва и в тестовете.
// `export` се маха, за да върви като обикновен скрипт преди първото рисуване.
const themeBootstrap = autoThemeSrc.replace(/^export /gm, '') + `
(function () {
  var mode = 'auto';
  try { mode = localStorage.getItem('theme-mode') || 'auto'; } catch (e) {}
  var root = document.documentElement;
  function apply() {
    var t = mode === 'auto' ? themeForDate() : mode;
    root.setAttribute('data-theme', t);
    root.setAttribute('data-theme-mode', mode);
  }
  apply();
  window.__theme = {
    get mode() { return mode; },
    set: function (m) {
      mode = m;
      try { localStorage.setItem('theme-mode', m); } catch (e) {}
      apply();
    },
    apply: apply,
    duskHour: duskHour,
    dawnHour: dawnHour,
    themeForDate: themeForDate
  };
})();`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={siteName} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏆</text></svg>" />
  <script is:inline set:html={themeBootstrap}></script>
</head>
<body>
  <div class="preview-banner">Визуализация за преглед — съдържанието е примерно</div>
  <Header />
  {breadcrumb && (
    <div class="wrap"><nav class="breadcrumb" set:html={breadcrumb} /></div>
  )}
  <main>
    <slot />
  </main>
  <Footer />
  <script is:inline>
    (function () {
      var T = window.__theme;
      if (!T) return;
      var btns = document.querySelectorAll('.theme-switch [data-mode]');
      function paint() {
        btns.forEach(function (b) {
          var on = b.dataset.mode === T.mode;
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
          b.classList.toggle('is-on', on);
        });
      }
      btns.forEach(function (b) {
        b.addEventListener('click', function () { T.set(b.dataset.mode); paint(); });
      });
      paint();

      // Ако страницата стои отворена през прага, темата се сменя сама.
      setInterval(function () { if (T.mode === 'auto') { T.apply(); paint(); } }, 60000);

      // Настройките за бисквитки отварят CMP-то, щом бъде включено.
      document.querySelectorAll('[data-cookie-settings]').forEach(function (b) {
        b.addEventListener('click', function () {
          if (window.googlefc && window.googlefc.showRevocationMessage) {
            window.googlefc.showRevocationMessage();
          } else if (window.__tcfapi) {
            window.__tcfapi('displayConsentUi', 2, function () {});
          } else {
            alert('Consent management is not enabled on this preview build.');
          }
        });
      });

      // Бургерът и падащите менюта се затварят при клик навън и с Esc.
      var opens = document.querySelectorAll('details.dd, details.burger');
      document.addEventListener('click', function (e) {
        opens.forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') opens.forEach(function (d) { d.removeAttribute('open'); });
      });
    })();
  </script>
</body>
</html>
