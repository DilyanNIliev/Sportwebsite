---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import sports from '../data/sports.json';
import { archivesFor } from '../data/archives.js';
import { standingsFor } from '../data/standings.js';

export function getStaticPaths() {
  return sports.map((s) => ({ params: { sport: s.slug }, props: { sport: s } }));
}

const { sport } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const news = (await getCollection('articles', (a) =>
  a.data.sport === sport.slug || (a.data.alsoSports ?? []).includes(sport.slug)
)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const archives = archivesFor(sport.slug);
const table = standingsFor(sport.slug);
const crumb = `<a href="${base}/">Home</a> › ${sport.name}`;
---
<Base title={sport.name} description={sport.tagline} breadcrumb={crumb}>
  <section class="hero accented" style={`--accent:${sport.accent};--accent-dark:${sport.accentDark}`}>
    <div class="wrap">
      <p class="eyebrow">{sport.tier === 1 ? 'Covered in depth' : 'Also covered'}</p>
      <h1>{sport.icon} {sport.name}</h1>
      <p class="lede">{sport.tagline}</p>
    </div>
  </section>

  <ArticleList articles={news} heading="Latest" />

  {table && (
    <section class="block">
      <div class="wrap">
        <div class="block-head"><h2>Championship standings</h2></div>
        <div class="cards">
          <a class="card" href={`${base}/standings/${table.slug}/`}>
            <div class="meta">
              <span class="accent" style={`--accent:${sport.accent};--accent-dark:${sport.accentDark}`}>{table.data.season}</span>
            </div>
            <h3>{table.data.drivers[0].name} leads on {table.data.drivers[0].points}</h3>
            <p>{table.data.asOf}</p>
          </a>
        </div>
      </div>
    </section>
  )}

  {archives.length > 0 && (
    <section class="block">
      <div class="wrap">
        <div class="block-head"><h2>Archives</h2></div>
        <div class="cards">
          {archives.map((a) => (
            <a class="card" href={`${base}/archives/${a.href}/`}>
              <div class="meta"><span class="accent" style={`--accent:${sport.accent};--accent-dark:${sport.accentDark}`}>Archive</span></div>
              <h3>{a.data.title}</h3>
              <p>{a.data.intro}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="block">
    <div class="wrap prose">
      <h2>Планирано за този раздел</h2>
      <p>
        Всеки раздел получава три слоя съдържание, описани в Стъпка 2: вечнозелени
        архиви като гръбнак, страници с данни, които се обновяват сами, и редакционни
        материали отгоре.
      </p>
      <ul>
        <li>Пълни архиви на шампионите по години</li>
        <li>Рекорди и статистически хъбове</li>
        <li>Профили на състезатели и отбори</li>
        <li>Материали, обясняващи правилата и историята</li>
      </ul>
    </div>
  </section>
</Base>
