---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import sports from '../data/sports.json';
import { archivesFor, archiveGroups, rowCount } from '../data/archives.js';
import nextEditions from '../data/next-editions.json';
import { standingsFor } from '../data/standings.js';
import SportMotif from '../components/SportMotif.astro';
import { sportVars } from '../data/sport-style.js';

export function getStaticPaths() {
  return sports.map((s) => ({ params: { sport: s.slug }, props: { sport: s } }));
}

const { sport } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const news = (await getCollection('articles', (a) =>
  a.data.sport === sport.slug || (a.data.alsoSports ?? []).includes(sport.slug)
)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const archives = archivesFor(sport.slug);
const groups = archiveGroups(sport.slug);
const next = nextEditions[sport.slug];
const tables = standingsFor(sport.slug);
const crumbs = [{ label: 'Home', href: `${base}/` }, { label: sport.name }];
const hasArchives = archives.length > 0;
const metaDesc =
  `${sport.name} records and history: ` +
  (hasArchives ? 'champions year by year, ' : '') +
  `reports and season data. ${sport.tagline}`;
---
<Base title={sport.name} description={metaDesc} crumbs={crumbs}>
  <section class="hero accented" style={sportVars(sport)}>
    <SportMotif motif={sport?.motif} />
    <div class="wrap">
      <p class="eyebrow">{sport.tier === 1 ? 'Covered in depth' : 'Also covered'}</p>
      <h1>{sport.icon} {sport.name}</h1>
      <p class="lede">{sport.tagline}</p>
    </div>
  </section>

  <ArticleList articles={news} heading="Latest" />

  {tables.length > 0 && (
    <section class="block">
      <div class="wrap">
        <div class="block-head"><h2>Current standings</h2></div>
        <div class="cards">
          {tables.map((t) => (
            <a class="card" href={`${base}/standings/${t.slug}/`}>
              <div class="meta">
                <span class="accent" style={sportVars(sport)}>{t.data.series}</span>
                <span>{t.data.season}</span>
              </div>
              <h3>{t.data.drivers[0].name} leads on {t.data.drivers[0].points.toLocaleString('en-GB')}</h3>
              <p>{t.data.asOf}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {groups.map((g) => (
    <section class="block" id={g.key}>
      <div class="wrap">
        <div class="block-head">
          <h2>{g.label}</h2>
          <p>{g.key === 'world' ? 'National teams and world championships.' : 'Club and league competitions.'}</p>
        </div>

        {g.key === 'world' && next && (
          <div class="next-edition">
            <p class="eyebrow">Next edition</p>
            <h3>{next.event}</h3>
            <p class="next-summary">{next.summary}</p>
            <dl class="next-facts">
              {next.rows.map(([k, v]) => (
                <>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </>
              ))}
            </dl>
            {next.caution && <p class="note">{next.caution}</p>}
            <p class="next-checked">{next.checked}</p>
          </div>
        )}

        <div class="cards">
          {g.items.map((a) => (
            <a class="card" href={`${base}/archives/${a.href}/`}>
              <div class="meta">
                <span class="accent" style={sportVars(sport)}>Archive</span>
                <span>{rowCount(a)} entries</span>
              </div>
              <h3>{a.data.title}</h3>
              <p>{a.data.intro}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  {groups.length === 0 && tables.length === 0 && news.length === 0 && (
  <section class="block">
    <div class="wrap prose">
      <h2>Планирано за този раздел</h2>
      <p>
        Всеки раздел получава три слоя съдържание, описани в Стъпка 2: вечнозелени
        архиви като гръбнак, страници с данни, които се обновяват сами, и редакционни
        материали отгоре.
      </p>
      <ul>
        <li>Пълни архиви на шампионите по години</li>
        <li>Рекорди и статистически хъбове</li>
        <li>Профили на състезатели и отбори</li>
        <li>Материали, обясняващи правилата и историята</li>
      </ul>
    </div>
  </section>
  )}
</Base>
