---
import Base from '../../layouts/Base.astro';
import { archives } from '../../data/archives.js';
import sports from '../../data/sports.json';
import SportMotif from '../../components/SportMotif.astro';
import { sportVars } from '../../data/sport-style.js';

export function getStaticPaths() {
  // Архивите с няколко таблици имат свои страници (напр. боксът с табовете).
  return archives
    .filter((a) => a.data.rows || a.data.tables)
    .map((a) => ({ params: { archive: a.href }, props: { data: a.data } }));
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sport = sports.find((s) => s.slug === data.sport);
const crumbs = [{ label: 'Home', href: `${base}/` }, { label: 'Archives', href: `${base}/archives/` }, { label: data.title }];

// Архивът може да е една таблица или няколко.
const tables = data.tables ?? [{ title: null, columns: data.columns, rows: data.rows }];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: data.title,
  description: data.intro,
};
---
<Base title={data.title} description={`${data.intro} Checked before publication.`} crumbs={crumbs}>
  <section class="hero accented" style={sportVars(sport)}>
    <SportMotif motif={sport?.motif} />
    <div class="wrap">
      <p class="eyebrow">{sport?.name} · Archive</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.intro}</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      {/* Ключовите дати стоят над таблиците — те са това, което се търси сега. */}
      {data.next && (
        <div class="next-edition" style="margin-bottom:34px">
          <p class="eyebrow">{data.next.eyebrow ?? 'Next edition'}</p>
          <h2 style="margin:8px 0 0;font-size:1.15rem">{data.next.event}</h2>
          <p class="next-summary">{data.next.summary}</p>
          <dl class="next-facts">
            {data.next.rows.map(([k, v]) => (
              <>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </>
            ))}
          </dl>
          {data.next.caution && <p class="note">{data.next.caution}</p>}
          <p class="next-checked">{data.next.checked}</p>
        </div>
      )}

      {tables.map((t, i) => (
        <>
          {t.title && (
            <div class="block-head" style={i > 0 ? 'margin-top:38px' : ''}><h2>{t.title}</h2></div>
          )}
          <div class="table-scroll">
            <table>
              <thead><tr>{t.columns.map((c) => <th>{c}</th>)}</tr></thead>
              <tbody>
                {t.rows.map((r) => (
                  <tr>{r.map((cell) => <td>{cell}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ))}
      <p class="note">{data.dataNote}</p>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
