---
import Base from '../../layouts/Base.astro';
import { archives } from '../../data/archives.js';
import sports from '../../data/sports.json';

export function getStaticPaths() {
  // Архивите с няколко таблици имат свои страници (напр. боксът с табовете).
  return archives
    .filter((a) => a.data.rows)
    .map((a) => ({ params: { archive: a.href }, props: { data: a.data } }));
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sport = sports.find((s) => s.slug === data.sport);
const crumbs = [{ label: 'Home', href: `${base}/` }, { label: 'Archives', href: `${base}/archives/` }, { label: data.title }];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: data.title,
  description: data.intro,
};
---
<Base title={data.title} description={`${data.intro} ${data.rows.length} entries, checked before publication.`} crumbs={crumbs}>
  <section class="hero accented" style={`--accent:${sport?.accent};--accent-dark:${sport?.accentDark}`}>
    <div class="wrap">
      <p class="eyebrow">{sport?.name} · Archive</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.intro}</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="table-scroll">
        <table>
          <thead>
            <tr>{data.columns.map((c) => <th>{c}</th>)}</tr>
          </thead>
          <tbody>
            {data.rows.map((r) => (
              <tr>{r.map((cell) => <td>{cell}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">{data.dataNote}</p>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
