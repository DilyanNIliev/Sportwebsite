---
import Base from '../../layouts/Base.astro';
import worldCup from '../../data/archives/world-cup.json';
import f1 from '../../data/archives/f1-champions.json';
import sports from '../../data/sports.json';

export function getStaticPaths() {
  return [
    { params: { archive: 'world-cup' }, props: { data: worldCup } },
    { params: { archive: 'f1-champions' }, props: { data: f1 } },
  ];
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sport = sports.find((s) => s.slug === data.sport);
const crumb = `<a href="${base}/">Home</a> › <a href="${base}/archives/">Archives</a> › ${data.title}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: data.title,
  description: data.intro,
};
---
<Base title={data.title} description={data.intro} breadcrumb={crumb}>
  <section class="hero" style={`border-top: 3px solid ${sport?.accent}`}>
    <div class="wrap">
      <p class="eyebrow">{sport?.name} · Archive</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.intro}</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="table-scroll">
        <table>
          <thead>
            <tr>{data.columns.map((c) => <th>{c}</th>)}</tr>
          </thead>
          <tbody>
            {data.rows.map((r) => (
              <tr>{r.map((cell) => <td>{cell}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">{data.dataNote}</p>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
