---
import Base from '../../layouts/Base.astro';
import { archives, rowCount } from '../../data/archives.js';
import sports from '../../data/sports.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const colour = (slug) => sports.find((s) => s.slug === slug) ?? {};
const items = archives.map((a) => ({ ...a, ...colour(a.data.sport), count: rowCount(a) }));
const crumb = `<a href="${base}/">Home</a> › Archives`;
---
<Base title="Archives" description="Complete champion archives across every sport we cover." breadcrumb={crumb}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Reference</p>
      <h1>Archives</h1>
      <p class="lede">
        Пълни, проверени списъци на шампионите. Това е гръбнакът на сайта — пише се
        веднъж и носи трафик години напред.
      </p>
    </div>
  </section>
  <section class="block">
    <div class="wrap">
      <div class="cards">
        {items.map((i) => (
          <a class="card" href={`${base}/archives/${i.href}/`}>
            <div class="meta">
              <span class="accent" style={`--accent:${i.accent};--accent-dark:${i.accentDark}`}>{i.data.sport}</span>
              <span>{i.count} entries</span>
            </div>
            <h3>{i.data.title}</h3>
            <p>{i.data.intro}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
