---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Lineups from '../../components/Lineups.astro';
import SportMotif from '../../components/SportMotif.astro';
import { sportVars } from '../../data/sport-style.js';
import { lineups } from '../../data/lineups.js';
import sports from '../../data/sports.json';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return Object.entries(lineups).map(([key, data]) => ({
    params: { match: key },
    // Статията, която сочи този състав, за да има връзка обратно към репортажа.
    props: { data, report: articles.find((a) => a.data.lineups === key) ?? null },
  }));
}

const { data, report } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sport = sports.find((s) => s.slug === (report?.data.sport ?? 'football'));
const crumbs = [
  { label: 'Home', href: `${base}/` },
  { label: sport?.name, href: `${base}/${sport?.slug}/` },
  { label: 'Line-ups' },
];

const names = data.teams.map((t) => t.team).join(' v ');
const shapes = data.teams.map((t) => `${t.team} ${t.formation}`).join(', ');

// Имената в описанието са това, което хората наистина търсят („кой игра“).
const description = `Both line-ups from ${data.match} at ${data.venue} on ${data.date}, laid out on the pitch: ${shapes}. Substitutes where they are confirmed.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: data.match,
  startDate: data.dateISO ?? undefined,
  location: { '@type': 'Place', name: data.venue },
  competitor: data.teams.map((t) => ({ '@type': 'SportsTeam', name: t.team })),
};
---
<Base
  title={`${names} line-ups`}
  seoTitle={`${names} line-ups`}
  description={description}
  crumbs={crumbs}
>
  <section class="hero accented" style={sportVars(sport)}>
    <SportMotif motif={sport?.motif} />
    <div class="wrap">
      <p class="eyebrow">{sport?.name} · Line-ups</p>
      <h1>{data.match}</h1>
      <p class="lede">{data.competition} · {data.venue} · {data.date}</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <Lineups data={data} showHead={false} />

      {report && (
        <p class="note back-to-report">
          The match report is at
          <a href={`${base}/news/${report.id}/`}>{report.data.title}</a>.
        </p>
      )}
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
