---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import sports from '../../data/sports.json';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sport = sports.find((s) => s.slug === article.data.sport);
const d = article.data.date;
const iso = d.toISOString().slice(0, 10);
const nice = d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const crumb = `<a href="${base}/">Home</a> › <a href="${base}/${sport?.slug}/">${sport?.name}</a> › News`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: article.data.title,
  description: article.data.description,
  datePublished: d.toISOString(),
  author: { '@type': 'Organization', name: article.data.author },
  publisher: { '@type': 'Organization', name: 'Global Sports Archive' },
};
---
<Base title={article.data.title} description={article.data.description} breadcrumb={crumb}>
  <article>
    <section class="hero accented" style={`--accent:${sport?.accent};--accent-dark:${sport?.accentDark}`}>
      <div class="wrap">
        <p class="eyebrow">
          <a class="accent" href={`${base}/${sport?.slug}/`} style={`--accent:${sport?.accent};--accent-dark:${sport?.accentDark}`}>{sport?.name}</a>
          · <time datetime={iso}>{nice}</time>
        </p>
        <h1>{article.data.title}</h1>
        <p class="lede">{article.data.description}</p>
      </div>
    </section>

    <section class="block">
      <div class="wrap prose article-body">
        <Content />

        <p class="note">
          Written for this site from the underlying facts, each confirmed against at
          least two independent records before publication. Spotted an error?
          <a href={`${base}/contact/`}>Tell us</a> and we will correct it.
          See our <a href={`${base}/editorial-policy/`}>editorial policy</a>.
        </p>
      </div>
    </section>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
