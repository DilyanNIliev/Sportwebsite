---
import Base from '../../layouts/Base.astro';
import sports from '../../data/sports.json';
import { archivesFor, rowCount } from '../../data/archives.js';

export function getStaticPaths() {
  return sports.map((s) => ({ params: { sport: s.slug }, props: { sport: s } }));
}

const { sport } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const archives = archivesFor(sport.slug);

// Страница без собствени данни още не е готова да се индексира.
// Тънкото съдържание е риск по политиката за scaled content abuse (Стъпка 2).
const thin = archives.length === 0;
const crumbs = [{ label: 'Home', href: `${base}/` }, { label: 'Statistics', href: `${base}/statistics/` }, { label: sport.name }];
---
<Base
  title={`${sport.name} statistics`}
  description={`Champions, records and season-by-season data for ${sport.name.toLowerCase()} — every title listed by year, most recent first, checked before publication.`}
  crumbs={crumbs}
  noindex={thin}
>
  <section class="hero accented" style={`--accent:${sport.accent};--accent-dark:${sport.accentDark}`}>
    <div class="wrap">
      <p class="eyebrow">{sport.name} · Statistics</p>
      <h1>{sport.icon} {sport.name} records</h1>
      <p class="lede">Champions, records and season-by-season data.</p>
    </div>
  </section>

  {archives.length > 0 ? (
    <section class="block">
      <div class="wrap">
        <div class="block-head"><h2>Available now</h2></div>
        <div class="cards">
          {archives.map((a) => (
            <a class="card" href={`${base}/archives/${a.href}/`}>
              <div class="meta">
                <span class="accent" style={`--accent:${sport.accent};--accent-dark:${sport.accentDark}`}>Archive</span>
                <span>{rowCount(a)} entries</span>
              </div>
              <h3>{a.data.title}</h3>
              <p>{a.data.intro}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="block">
      <div class="wrap prose">
        <p class="note">
          Тази страница още няма собствени данни, затова е маркирана с
          <code>noindex</code> — празните страници вредят на класирането на целия
          сайт. Индексирането се включва автоматично, щом се добавят архивите ѝ.
        </p>
      </div>
    </section>
  )}
</Base>
